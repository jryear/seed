#!/usr/bin/env python3
"""ex - step into a running world.   EX_WORLD=<dir> (default ./world)   EX_AS=<your name>"""
import json, os, sys, urllib.request

world = os.environ.get('EX_WORLD', os.path.join(os.path.dirname(os.path.abspath(__file__)), 'world'))
me = os.environ.get('EX_AS', '')
args = sys.argv[1:] or ['look']
op, rest = args[0], args[1:]
q = {'op': op, 'as': me}
for flag, k in (('--on', 'on'), ('--for', 'for')):
    if flag in rest:
        i = rest.index(flag)
        q[k] = rest[i + 1]
        del rest[i:i + 2]
shape = {'look': ['target'], 'why': ['target'], 'history': ['target'], 'eval': ['src'], 'suppose': ['name', 'src'],
         'define': ['name', 'src'], 'claim': ['text', 'src'], 'counter': ['claim', 'src'], 'retire': ['claim', 'why'],
         'dispute': ['claim', 'why'], 'note': ['target', 'text'], 'intend': ['text'], 'resolve': ['pursuit', 'text'],
         'retry': ['held'], 'withdraw': ['held'], 'grant': ['name', 'role'], 'enroll': ['name'], 'help': []}
if op not in shape:
    sys.exit('no such move: %s (try: ex help)' % op)
for k, v in zip(shape[op], rest):
    q[k] = v
try:
    port = open(os.path.join(world, 'port')).read().strip()
    if me:
        q['key'] = open(os.path.join(world, 'keys', me + '.key')).read().strip()
except OSError:
    pass
if op not in ('help', 'enroll') and not me:
    sys.exit('say who you are: EX_AS=<name> ex ...   (first time: ex enroll <name>)')
try:
    r = urllib.request.urlopen(urllib.request.Request('http://127.0.0.1:%s/x' % port, json.dumps(q).encode()), timeout=120)
    out = json.loads(r.read())
except Exception as e:
    sys.exit('no world is running at %s (%s)' % (world, e))
print(out['text'])
sys.exit(0 if out['ok'] else 1)
